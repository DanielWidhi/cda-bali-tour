generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TourPackage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String // sengaja 1 bahasa (nama produk bersifat universal)
  category      String
  categoryLabel String
  location      String // sengaja 1 bahasa
  durationHours Int // angka murni — satuan "jam"/"hours" ditentukan otomatis oleh locale
  price         Int
  originalPrice Int?
  rating        Float    @default(5)
  reviewCount   Int      @default(0)
  coverImage    String
  gallery       String[]

  // Semua field di bawah ini bilingual, format JSON: { "id": "...", "en": "..." }
  // Array bilingual (highlights/includes/excludes): [{ "id": "...", "en": "..." }, ...]
  // itinerary: [{ "time": "05.30", "activity": { "id": "...", "en": "..." } }, ...]
  // faq: [{ "question": {...}, "answer": {...} }, ...]
  // Desain JSON fleksibel ini sengaja dipilih supaya nambah bahasa baru (misal zh)
  // nanti TIDAK perlu ubah struktur database — cukup tambah key baru di tiap objek.
  shortDescription Json
  description      Json
  highlights       Json
  itinerary        Json
  includes         Json
  excludes         Json
  faq              Json

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tour_packages")
}

model Transport {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String // sengaja 1 bahasa
  capacityMin  Int
  capacityMax  Int
  pricePerDay  Int
  hours        Int
  image        String
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("transport_options")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  origin    String
  phone     String?
  rating    Int      @default(5)
  quote     String   @db.Text
  tourSlug  String?
  published Boolean  @default(false) // testimoni publik butuh approval admin dulu
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@map("gallery_images")
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

// Data profil admin, terhubung 1:1 dengan user di Supabase Auth (auth.users.id)
model Profile {
  id        String    @id
  email     String    @unique
  name      String
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("profiles")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  contact   String? // nomor WA / email
  message   String        @db.Text
  source    String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("inquiries")
}
