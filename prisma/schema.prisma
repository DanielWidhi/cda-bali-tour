generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TourPackage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String // sengaja 1 bahasa (nama produk bersifat universal)
  category      String
  categoryLabel String
  location      String // sengaja 1 bahasa
  durationHours Int // angka murni — satuan "jam"/"hours" ditentukan otomatis oleh locale
  price         Int // IDR
  originalPrice Int? // IDR
  priceUsd         Int? // USD — tampil saat bahasa EN; kosong => fallback ke harga IDR
  originalPriceUsd Int? // USD (harga coret)
  rating        Float    @default(5)
  reviewCount   Int      @default(0)
  coverImage    String
  gallery       String[]

  // Semua field di bawah ini bilingual, format JSON: { "id": "...", "en": "..." }
  // Array bilingual (highlights/includes/excludes): [{ "id": "...", "en": "..." }, ...]
  // itinerary: [{ "time": "05.30", "activity": { "id": "...", "en": "..." } }, ...]
  // faq: [{ "question": {...}, "answer": {...} }, ...]
  // Desain JSON fleksibel ini sengaja dipilih supaya nambah bahasa baru (misal zh)
  // nanti TIDAK perlu ubah struktur database — cukup tambah key baru di tiap objek.
  shortDescription Json
  description      Json
  highlights       Json
  itinerary        Json
  includes         Json
  excludes         Json
  faq              Json

  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tour_packages")
}

model Transport {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String // sengaja 1 bahasa
  capacityMin    Int
  capacityMax    Int
  pricePerDay    Int // IDR
  pricePerDayUsd Int? // USD — kosong => fallback ke IDR
  hours          Int
  image          String
  gallery        String[] @default([]) // foto tambahan: eksterior, interior, bagasi
  description    Json? // bilingual { id, en } — ditampilkan di halaman detail
  luggage        Json? // bilingual { id, en } — info bagasi, misal "3 koper besar"
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  zonePrices     TransportZonePrice[]

  @@map("transport_options")
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  origin    String
  phone     String?
  rating    Int      @default(5)
  quote     String   @db.Text
  tourSlug  String?
  published Boolean  @default(false) // testimoni publik butuh approval admin dulu
  createdAt DateTime @default(now())

  @@map("testimonials")
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@map("gallery_images")
}

enum AdminRole {
  SUPERADMIN
  ADMIN
}

// Data profil admin, terhubung 1:1 dengan user di Supabase Auth (auth.users.id)
model Profile {
  id        String    @id
  email     String    @unique
  name      String
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("profiles")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  contact   String? // nomor WA / email
  message   String        @db.Text
  source    String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("inquiries")
}

// ===== Zona transport (tetap 4 zona; deskripsi area diisi admin, bilingual) =====
model TransportZone {
  id          String               @id @default(cuid())
  number      Int                  @unique // 1..4 — nama tampil "Zona N" / "Zone N" otomatis mengikuti bahasa
  description Json // bilingual { id, en } — mencakup daerah mana saja
  image       String? // foto/peta zona (opsional, diunggah admin)
  prices      TransportZonePrice[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@map("transport_zones")
}

// Harga satu kendaraan di satu zona (IDR & USD diinput terpisah oleh admin)
model TransportZonePrice {
  id          String        @id @default(cuid())
  transportId String
  zoneId      String
  priceIdr    Int
  priceUsd    Int?
  transport   Transport     @relation(fields: [transportId], references: [id], onDelete: Cascade)
  zone        TransportZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([transportId, zoneId])
  @@map("transport_zone_prices")
}

// ===== Our Service (Rent Car, Airport Transfer, Hotel Transfer, Couple, Honeymoon, dst) =====
model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            Json // bilingual { id, en }
  shortDescription Json // bilingual
  description      Json // bilingual
  highlights       Json // [{ id, en }]
  includes         Json // [{ id, en }]
  excludes         Json // [{ id, en }]
  faq              Json // [{ question: {id,en}, answer: {id,en} }]
  coverImage       String?
  gallery          String[] @default([])
  // Kalau diisi, kartu layanan mengarah ke sini (mis. "/tour?category=day-tour")
  // alih-alih ke halaman detail layanan. Dipakai untuk layanan yang sudah punya halaman sendiri.
  linkHref         String?
  // Tampilkan tombol "Lihat armada & harga zona" (menuju /transport) di halaman detail
  showTransportCta Boolean  @default(false)
  sortOrder        Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("services")
}
